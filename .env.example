PORT=3210
APP_NAME=Relay Station
APP_SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SAME_SITE=Strict
SESSION_COOKIE_SECURE=0

# Authentication
AUTH_MIN_PASSWORD_LENGTH=6
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
DATA_DIR=

# Root administrator
ROOT_ADMIN_USERNAME=root
ROOT_ADMIN_DISPLAY_NAME=Root Admin
ROOT_ADMIN_PASSWORD=
ROOT_ADMIN_ALLOW_WEAK_PASSWORD=0
ROOT_ADMIN_REPO_URL=
ROOT_ADMIN_REPO_PATH=
ROOT_ADMIN_REPO_BRANCH=main

# Chat mode
CHAT_DEFAULT_PROVIDER=auto

OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_CHAT_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_CHAT_MODEL=gpt-5
OPENAI_CHAT_MODELS=gpt-5,gpt-5-mini

ZHIPU_API_KEY=
ZHIPU_CHAT_MODELS=glm-4-flash

DEEPSEEK_API_KEY=
DEEPSEEK_API_KEYS=
DEEPSEEK_CHAT_MODELS=deepseek-chat,deepseek-reasoner

GITHUB_MODELS_API_KEY=
GITHUB_MODELS_CHAT_MODELS=openai/gpt-4.1-mini,openai/gpt-4.1,openai/gpt-4o-mini

SILICONFLOW_API_KEY=
SILICONFLOW_API_KEYS=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
SILICONFLOW_CHAT_MODELS=Qwen/Qwen3-VL-235B-A22B-Thinking,deepseek-ai/DeepSeek-R1

OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODELS=openrouter/free
OPENROUTER_REFERER=http://127.0.0.1:3210
OPENROUTER_TITLE=Relay Station

ALIBABA_BAILIAN_API_KEY=
ALIBABA_BAILIAN_API_KEYS=
ALIBABA_BAILIAN_CHAT_MODELS=qwen-plus-2025-12-01,qwen-plus-2025-07-28,qwen-turbo-latest,qwen3.5-35b-a3b,qwen-max-latest,qwen3-omni-flash,qwen2.5-omni-7b,qwen-omni-turbo-latest
AUTO_CHAT_TEXT_ROUTE=siliconflow:deepseek-ai/DeepSeek-R1,alibaba_bailian:qwen-plus-2025-12-01,alibaba_bailian:qwen-plus-2025-07-28,alibaba_bailian:qwen-turbo-latest,alibaba_bailian:qwen3.5-35b-a3b,alibaba_bailian:qwen-max-latest
AUTO_CHAT_VISION_ROUTE=siliconflow:Qwen/Qwen3-VL-235B-A22B-Thinking,alibaba_bailian:qwen3-omni-flash,alibaba_bailian:qwen3-omni-flash-2025-12-01,alibaba_bailian:qwen3-omni-flash-2025-09-15,alibaba_bailian:qwen2.5-omni-7b,alibaba_bailian:qwen-omni-turbo-latest
AUTO_CHAT_RETRY_COOLDOWN_MS=120000
AUTO_CHAT_QUOTA_COOLDOWN_MS=900000
AUTO_CHAT_CIRCUIT_BREAKER_THRESHOLD=3
AUTO_CHAT_CIRCUIT_BREAKER_MS=600000
ADMIN_DISPATCH_HISTORY_LIMIT=200

STEPFUN_API_KEY=
STEPFUN_CHAT_MODELS=step-1-8k

TENCENT_HUNYUAN_API_KEY=
TENCENT_HUNYUAN_CHAT_MODELS=hunyuan-lite

# Attachments
MAX_UPLOAD_FILES=5
MAX_UPLOAD_BYTES=10485760
CHAT_ATTACHMENT_TEXT_BYTES=65536
CHAT_INLINE_IMAGE_BYTES=5242880

# Code mode
CODEX_BIN=codex
CODEX_TIMEOUT_MS=1800000
CODE_QUEUE_CONCURRENCY=1
CODE_AUTO_PUSH=1
GIT_PUSH_TIMEOUT_MS=300000
GIT_AUTHOR_NAME=Relay Station Bot
GIT_AUTHOR_EMAIL=relay-station@local

# Optional first-user bootstrap
BOOTSTRAP_USERNAME=owner
BOOTSTRAP_PASSWORD=
BOOTSTRAP_DISPLAY_NAME=Owner
BOOTSTRAP_REPO_URL=https://github.com/znyee/owner-mcq.git
BOOTSTRAP_REPO_PATH=/home/ubuntu/repos/owner-mcq
BOOTSTRAP_REPO_BRANCH=main
